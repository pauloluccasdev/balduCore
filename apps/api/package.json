{
  "name": "@balducore/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && concurrently -k \"tsc -w --preserveWatchOutput\" \"node --env-file=../../.env --watch dist/main.js\"",
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "db:generate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "test": "pnpm build && node --test dist/config.test.js dist/health.test.js dist/security.test.js dist/garmin.test.js",
    "test:integration": "pnpm build && node --env-file=../../.env --test --test-concurrency=1 dist/database.integration.test.js dist/auth.integration.test.js dist/demo.integration.test.js dist/invitations.integration.test.js dist/garmin.integration.test.js",
    "test:e2e:server": "node --env-file=../../.env dist/test-support/e2e-server.js",
    "maintenance": "pnpm build && node --env-file=../../.env dist/scripts/maintenance.js",
    "worker": "node --env-file=../../.env dist/worker.js",
    "garmin:setup": "pnpm build && node --env-file=../../.env dist/scripts/setup-garmin-mock.js",
    "worker:dev": "node --env-file=../../.env --watch dist/worker.js",
    "dev:compiled": "concurrently -k \"tsc -w --preserveWatchOutput\" \"node --env-file=../../.env --watch dist/main.js\""
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie": "2.0.2",
    "openid-client": "6.9.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1"
  }
}
