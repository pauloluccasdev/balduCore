generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RelationshipStatus {
  pending
  active
  ended
}

model Coach {
  id        String @id @default(uuid())
  issuer    String
  subject   String
  name      String
  email     String
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  sessions  CoachSession[]
  athletes  Athlete[]
  relationships CoachAthleteRelationship[]
  audits AuditLog[]
  @@unique([issuer, subject])
}

model CoachSession {
  id        String @id @default(uuid())
  tokenHash String @unique
  coachId   String
  coach     Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model AuthAttempt {
  stateHash String @id
  browserHash String
  encryptedChecks String
  expiresAt DateTime
  consumedAt DateTime?
  @@index([expiresAt])
}

model Athlete {
  id        String @id @default(uuid())
  coachId   String
  coach     Coach @relation(fields: [coachId], references: [id], onDelete: Restrict)
  name      String
  email     String
  version   Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  relationship CoachAthleteRelationship?
  @@unique([coachId, id])
  @@unique([coachId, email])
  @@index([coachId, createdAt])
}

model CoachAthleteRelationship {
  id String @id @default(uuid())
  coachId String
  coach Coach @relation(fields: [coachId], references: [id], onDelete: Restrict)
  athleteId String @unique
  athlete Athlete @relation(fields: [coachId, athleteId], references: [coachId, id], onDelete: Restrict)
  status RelationshipStatus @default(pending)
  createdAt DateTime @default(now())
  endedAt DateTime?
  invitations Invitation[]
  consents ConsentEvidence[]
  withdrawalAccesses WithdrawalAccess[]
  garminConnection GarminConnection?
  @@unique([coachId, athleteId])
  @@index([coachId, status])
}

model AuditLog {
  id String @id @default(uuid())
  coachId String
  coach Coach @relation(fields: [coachId], references: [id], onDelete: Restrict)
  action String
  resourceId String
  createdAt DateTime @default(now())
  @@index([coachId, createdAt])
}

model RateLimitBucket {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

enum ConsentDecision {
  accepted
  withdrawn
}

model Invitation {
  id String @id @default(uuid())
  coachId String
  athleteId String
  relationship CoachAthleteRelationship @relation(fields: [coachId, athleteId], references: [coachId, athleteId], onDelete: Restrict)
  recipientEmail String
  purpose String @default("accompaniment")
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  enrollment EnrollmentSession?
  @@unique([coachId, athleteId, id])
  @@unique([coachId, id])
  @@index([coachId, athleteId, createdAt])
}

model EnrollmentSession {
  id String @id @default(uuid())
  coachId String
  invitationId String @unique
  athleteId String
  invitation Invitation @relation(fields: [coachId, athleteId, invitationId], references: [coachId, athleteId, id], onDelete: Restrict)
  tokenHash String @unique
  expiresAt DateTime
  codeHash String?
  encryptedCode String?
  codeExpiresAt DateTime
  codeAttempts Int @default(0)
  verifiedAt DateTime?
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  evidences ConsentEvidence[]
  garminAuthorizations GarminAuthorizationAttempt[]
  @@unique([coachId, athleteId, invitationId])
  @@unique([coachId, athleteId, id])
  @@unique([coachId, id])
  @@index([expiresAt])
}

model ConsentDocument {
  id String @id
  purpose String
  version String
  content String
  contentHash String
  isSynthetic Boolean @default(true)
  evidences ConsentEvidence[]
  @@unique([purpose, version])
}

model ConsentEvidence {
  id String @id @default(uuid())
  coachId String
  athleteId String
  relationship CoachAthleteRelationship @relation(fields: [coachId, athleteId], references: [coachId, athleteId], onDelete: Restrict)
  enrollmentId String
  enrollment EnrollmentSession @relation(fields: [coachId, athleteId, enrollmentId], references: [coachId, athleteId, id], onDelete: Restrict)
  documentId String
  document ConsentDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  decision ConsentDecision
  verificationMode String @default("demo")
  isSynthetic Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([coachId, enrollmentId, documentId, decision])
  @@index([coachId, athleteId, createdAt])
}

model WithdrawalAccess {
  id String @id @default(uuid())
  coachId String
  athleteId String
  relationship CoachAthleteRelationship @relation(fields: [coachId, athleteId], references: [coachId, athleteId], onDelete: Restrict)
  tokenHash String @unique
  sessionHash String? @unique
  expiresAt DateTime
  sessionExpiresAt DateTime?
  redeemedAt DateTime?
  consumedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([coachId, athleteId])
}

enum GarminStatus {
  not_connected
  awaiting_authorization
  connected
  error
  disconnected
}

enum IntegrationEventStatus {
  queued
  processing
  retry
  processed
  ignored
  failed
  cancelled
}

model GarminConnection {
  id String @id @default(uuid())
  coachId String
  athleteId String
  relationship CoachAthleteRelationship @relation(fields: [coachId, athleteId], references: [coachId, athleteId], onDelete: Restrict)
  provider String @default("garmin_mock")
  isSynthetic Boolean @default(true)
  status GarminStatus @default(not_connected)
  generation Int @default(0)
  externalAccountHash String? @unique
  encryptedCredentials String?
  keyVersion String @default("local-v1")
  tokenExpiresAt DateTime?
  credentialVersion Int @default(0)
  refreshLease String?
  refreshLeaseUntil DateTime?
  revocationStatus String @default("none")
  lastReceivedAt DateTime?
  lastSyncedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorizations GarminAuthorizationAttempt[]
  events IntegrationEvent[]
  activities Activity[]
  @@unique([coachId, athleteId])
  @@unique([coachId, athleteId, id])
}

model GarminAuthorizationAttempt {
  id String @id @default(uuid())
  coachId String
  athleteId String
  connectionId String
  connection GarminConnection @relation(fields: [coachId, athleteId, connectionId], references: [coachId, athleteId, id], onDelete: Restrict)
  enrollmentId String
  enrollment EnrollmentSession @relation(fields: [coachId, athleteId, enrollmentId], references: [coachId, athleteId, id], onDelete: Restrict)
  stateHash String @unique
  browserHash String
  generation Int
  expiresAt DateTime
  consumedAt DateTime?
  outcome String?
  @@index([expiresAt])
}

model IntegrationEvent {
  id String @id @default(uuid())
  coachId String
  athleteId String
  connectionId String
  connection GarminConnection @relation(fields: [coachId, athleteId, connectionId], references: [coachId, athleteId, id], onDelete: Restrict)
  generation Int
  kind String
  deliveryId String
  payloadHash String
  encryptedPayload String?
  namespace String
  jobId String?
  runToken String?
  leaseUntil DateTime?
  status IntegrationEventStatus @default(queued)
  attempts Int @default(0)
  errorCode String?
  createdAt DateTime @default(now())
  processedAt DateTime?
  @@unique([connectionId, generation, kind, deliveryId])
  @@index([coachId, athleteId, createdAt])
  @@index([namespace, status])
}

// Envelope mínimo da SPRINT 04; detalhes esportivos e consultas entram na 05.
model Activity {
  id String @id @default(uuid())
  coachId String
  athleteId String
  connectionId String
  connection GarminConnection @relation(fields: [coachId, athleteId, connectionId], references: [coachId, athleteId, id], onDelete: Restrict)
  generation Int
  externalId String
  revision Int
  source String @default("garmin_mock")
  isSynthetic Boolean @default(true)
  sport String
  startedAt DateTime
  durationSeconds Float?
  distanceMeters Float?
  dataHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([connectionId, generation, externalId])
  @@index([coachId, athleteId, startedAt])
}

model WorkerHeartbeat {
  name String @id
  seenAt DateTime
}
