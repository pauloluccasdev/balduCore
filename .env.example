# Credenciais apenas para desenvolvimento local; não reutilizar em produção.
POSTGRES_USER=balducore
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=balducore
POSTGRES_PORT=5432
DATABASE_URL=postgresql://balducore:local_dev_only@127.0.0.1:5432/balducore
API_PORT=3001
API_HOST=127.0.0.1
LOG_LEVEL=info
NODE_ENV=development

# Banco isolado para integração e E2E; nunca usar o banco operacional.
TEST_DATABASE_URL=postgresql://balducore:local_dev_only@127.0.0.1:5432/balducore_test
# Origem pública exata, sem barra final; HTTPS obrigatório em produção.
APP_ORIGIN=http://127.0.0.1:3000
# Login fictício local, sem Google. Em produção usar google.
AUTH_MODE=demo
# Preencher os três para habilitar login real. Nunca versionar credenciais.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# Lista de e-mails Gmail/Workspace autorizados (separados por vírgula).
GOOGLE_ALLOWED_EMAILS=
# Para contas Google de domínio externo sem Workspace, autorizar pelo sub confirmado.
GOOGLE_ALLOWED_SUBJECTS=
SESSION_HOURS=8
