{
  "name": "balducore",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @balducore/api build && concurrently -k -n api,web,worker \"pnpm --filter @balducore/api dev:compiled\" \"pnpm --filter @balducore/web dev\" \"pnpm --filter @balducore/api worker:dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @balducore/api test",
    "test:integration": "pnpm --filter @balducore/api test:integration",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @balducore/api db:generate",
    "db:migrate": "pnpm --filter @balducore/api db:migrate",
    "db:deploy": "pnpm --filter @balducore/api db:deploy",
    "db:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "db:test:deploy": "node scripts/test-database.mjs",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "garmin:setup": "pnpm --filter @balducore/api garmin:setup"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.10.1",
    "eslint": "10.15.0",
    "typescript-eslint": "8.72.2",
    "prettier": "3.10.1",
    "@playwright/test": "1.65.1",
    "concurrently": "10.0.7",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint-plugin-react-hooks": "7.1.1"
  }
}
